name: CI

on:
  push:
    branches: [ main, dev, shader-work ]
  pull_request:
    branches: [ main, dev ]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Install Rust
        uses: actions-rs/toolchain@v1
        with:
          toolchain: stable
      - name: Format check
        run: cargo fmt --all -- --check
      - name: Clippy
        run: cargo clippy --all-targets --all-features -- -D warnings
      - name: Run workspace tests
        run: cargo test --all --workspace -- -q
      - name: Run moho_ui tests with egui feature
        run: cargo test -p moho_ui --features "ui-egui ui-egui-test" -- -q
